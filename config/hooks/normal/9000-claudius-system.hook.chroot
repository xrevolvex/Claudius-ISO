#!/bin/sh
# =============================================================================
#  Claudius system setup. Runs inside the image while it is being built.
# =============================================================================
set -e
. /etc/claudius-release
V="$CLAUDIUS_VERSION"; C="$CLAUDIUS_CODENAME"; U="$CLAUDIUS_URL"

echo "I: [claudius] tools and services"
chmod 755 /usr/bin/claudius /usr/bin/claudius-* /usr/lib/claudius/claudius-* /usr/lib/claudius/live-setup \
          /usr/lib/claudius/update-check /usr/lib/claudius/*.py /usr/lib/claudius/center/app.py
systemctl enable claudius-tune.service claudius-live.service
systemctl --global enable claudius-update-check.timer || true
# file search index for the Launcher (refreshed daily by plocate's timer)
command -v updatedb >/dev/null && updatedb 2>/dev/null || true
# compile the Claudius Python apps once, so they start faster
python3 -m compileall -q /usr/lib/claudius >/dev/null 2>&1 || true

echo "I: [claudius] boot animation"
if [ -d /usr/share/plymouth/themes/claudius ]; then
    plymouth-set-default-theme claudius || echo "   (could not set the plymouth theme)"
    update-initramfs -u -k all || echo "   (initramfs update failed)"
    echo "   plymouth theme: $(plymouth-set-default-theme)"
fi

echo "I: [claudius] identity"
# ---------------------------------------------------------------- os-release
if ! dpkg-divert --list /usr/lib/os-release | grep -q claudius; then
    dpkg-divert --package claudius --local --rename --divert /usr/lib/os-release.debian --add /usr/lib/os-release
fi
cat > /usr/lib/os-release <<EOF
PRETTY_NAME="Claudius $V ($C)"
NAME="Claudius"
VERSION_ID="$V"
VERSION="$V ($C)"
VERSION_CODENAME=trixie
ID=claudius
ID_LIKE=debian
HOME_URL="$U"
SUPPORT_URL="$U/discussions"
BUG_REPORT_URL="$U/issues"
LOGO=claudius
EOF
ln -sf ../usr/lib/os-release /etc/os-release

for f in /etc/issue /etc/issue.net; do
    if ! dpkg-divert --list "$f" | grep -q claudius; then
        dpkg-divert --package claudius --local --rename --divert "$f.debian" --add "$f"
    fi
done
printf 'Claudius %s (%s) \\n \\l\n\n' "$V" "$C" > /etc/issue
printf 'Claudius %s (%s)\n' "$V" "$C" > /etc/issue.net
cat > /etc/motd <<EOF

  Welcome to Claudius $V ($C). Type 'claudius' for handy shortcuts.

EOF

echo "I: [claudius] desktop defaults"
# ---------------------------------------------------------------- wallpaper
# Debian's desktop-base points every desktop at this alternative; point it at ours.
if [ -d /usr/share/images/desktop-base ]; then
    for alt in desktop-background desktop-background.xml desktop-login-background; do
        update-alternatives --install "/usr/share/images/desktop-base/$alt" "$alt" \
            /usr/share/claudius/wallpapers/claudius-default.png 90 2>/dev/null || true
        update-alternatives --set "$alt" /usr/share/claudius/wallpapers/claudius-default.png 2>/dev/null || true
    done
fi
# XFCE's built-in fallback wallpaper
if [ -d /usr/share/backgrounds/xfce ]; then
    ln -sf /usr/share/claudius/wallpapers/claudius-default.png /usr/share/backgrounds/xfce/xfce-shapes.svg.claudius
fi

# ---------------------------------------------------------------- shell
if ! grep -q 'CLAUDIUS-BASHRC' /etc/skel/.bashrc; then
    cat /usr/share/claudius/skel/bashrc-append >> /etc/skel/.bashrc
fi
if ! grep -q 'CLAUDIUS-BASHRC' /root/.bashrc 2>/dev/null; then
    cat /usr/share/claudius/skel/bashrc-append >> /root/.bashrc
fi

# ---------------------------------------------------------------- Firefox
# Default prefs and policies wherever this Firefox ESR build looks for them
for d in /usr/lib/firefox-esr/defaults/pref /etc/firefox-esr; do
    if [ -d "$d" ]; then cp /usr/share/claudius/firefox/claudius-prefs.js "$d/claudius-prefs.js"; fi
done
for d in /usr/lib/firefox-esr/distribution /etc/firefox/policies /etc/firefox-esr/policies; do
    mkdir -p "$d"; cp /usr/share/claudius/firefox/policies.json "$d/policies.json"
done

echo "I: [claudius] installer"
# ---------------------------------------------------------------- Calamares
if [ -f /etc/calamares/settings.conf ]; then
    sed -i 's/^branding:.*/branding: claudius/' /etc/calamares/settings.conf
    # The ISO carries no package pool: skip the steps that mount it as an apt source
    sed -i -e '/^[[:space:]]*-[[:space:]]*sources-media$/d' \
           -e '/^[[:space:]]*-[[:space:]]*sources-media-unmount$/d' /etc/calamares/settings.conf
    echo "---- calamares install sequence ----"; sed -n '/^- exec:/,/^- show:/p' /etc/calamares/settings.conf
    echo "---- calamares modules ----"; ls /etc/calamares/modules/ /usr/lib/calamares/modules/ 2>/dev/null | tr '\n' ' '; echo
    for d in /usr/lib/calamares/modules/bootloader-config; do
        [ -d "$d" ] && for f in "$d"/*; do echo "== $f"; cat "$f"; done
    done
fi
# Both GRUB flavours ship as .debs; the installer picks the one for BIOS or UEFI
mkdir -p /usr/share/claudius/grub-debs
( cd /usr/share/claudius/grub-debs && apt-get download grub-pc grub-efi-amd64 ) \
    || echo "   (could not download grub .debs)"
ls -la /usr/share/claudius/grub-debs
# Debian's own "Install Debian" launcher is replaced by "Install Claudius"
rm -f /usr/share/applications/install-debian.desktop /usr/share/applications/calamares.desktop \
      /usr/share/applications/calamares-install-debian.desktop \
      /etc/xdg/autostart/calamares-desktop-icon.desktop \
      /etc/skel/Desktop/install-debian.desktop 2>/dev/null || true

# ---------------------------------------------------------------- GRUB on the installed system
mkdir -p /etc/default/grub.d
cat > /etc/default/grub.d/90-claudius.cfg <<'EOF'
GRUB_DISTRIBUTOR="Claudius"
GRUB_TIMEOUT=2
GRUB_CMDLINE_LINUX_DEFAULT="quiet"
GRUB_BACKGROUND="/usr/share/claudius/boot/grub-background.png"
EOF

echo "I: [claudius] python and ubuntu-style features"
# ---------------------------------------------------------------- .py files open in Thonny
THONNY=$(basename "$(ls /usr/share/applications/*honny*.desktop 2>/dev/null | head -n1)" 2>/dev/null)
[ -n "$THONNY" ] || THONNY=geany.desktop
for f in /etc/xdg/mimeapps.list /usr/share/applications/mimeapps.list; do
    cat > "$f" <<MIME
[Default Applications]
text/x-python3=$THONNY;claudius-run-python.desktop;
text/x-python=$THONNY;claudius-run-python.desktop;
text/html=firefox-esr.desktop
x-scheme-handler/http=firefox-esr.desktop
x-scheme-handler/https=firefox-esr.desktop
application/pdf=atril.desktop
inode/directory=thunar.desktop

[Added Associations]
text/x-python3=$THONNY;claudius-run-python.desktop;geany.desktop;
text/x-python=$THONNY;claudius-run-python.desktop;geany.desktop;
MIME
done
echo "   .py files open with $THONNY"
# "python" runs python3
[ -e /usr/bin/python ] || ln -s python3 /usr/bin/python

# ---------------------------------------------------------------- firewall on (ufw: deny incoming, allow outgoing)
if [ -f /etc/ufw/ufw.conf ]; then
    sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
    systemctl enable ufw.service >/dev/null 2>&1 || true
fi

# ---------------------------------------------------------------- automatic security updates (installed system)
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'AUTO'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
AUTO

# ---------------------------------------------------------------- Flathub
if command -v flatpak >/dev/null 2>&1; then
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || echo "   (flathub not added)"
fi

# ---------------------------------------------------------------- command-not-found database
if command -v update-command-not-found >/dev/null 2>&1; then
    apt-get update -qq >/dev/null 2>&1 || true
    update-command-not-found >/dev/null 2>&1 || echo "   (command-not-found index not built)"
fi

echo "I: [claudius] slimming for low RAM"
# ---------------------------------------------------------------- remove services a VM desktop doesn't need
for p in modemmanager bluez cups cups-daemon cups-browsed avahi-daemon exim4-base exim4-daemon-light \
         xscreensaver; do
    if dpkg -s "$p" >/dev/null 2>&1; then
        echo "   purging $p"
        apt-get purge -y "$p" >/dev/null 2>&1 || echo "   (could not purge $p)"
    fi
done
for t in man-db.timer e2scrub_all.timer \
         NetworkManager-wait-online.service ModemManager.service; do
    systemctl disable "$t" >/dev/null 2>&1 || true
done
systemctl mask NetworkManager-wait-online.service >/dev/null 2>&1 || true
systemctl enable zramswap.service >/dev/null 2>&1 || true

# ---------------------------------------------------------------- caches
locale-gen en_US.UTF-8 >/dev/null 2>&1 || true
update-locale LANG=en_US.UTF-8 2>/dev/null || true
gtk-update-icon-cache -f -q /usr/share/icons/hicolor 2>/dev/null || true
gtk-update-icon-cache -f -q /usr/share/icons/Papirus-Dark 2>/dev/null || true
update-desktop-database -q /usr/share/applications 2>/dev/null || true
fc-cache -f >/dev/null 2>&1 || true
apt-get clean
rm -rf /var/lib/apt/lists/*_Translation-* /tmp/* 2>/dev/null || true

echo "I: [claudius] system hook done"
