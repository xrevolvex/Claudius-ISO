<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Claudius</vendor>
  <vendor_url>https://github.com/xrevolvex/Claudius-ISO</vendor_url>
  <action id="org.claudius.helper">
    <description>Change system settings with Claudius Center</description>
    <message>Claudius needs your password to change system settings or install software.</message>
    <icon_name>claudius</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/claudius/claudius-helper</annotate>
  </action>
</policyconfig>
