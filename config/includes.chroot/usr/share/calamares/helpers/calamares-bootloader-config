#!/bin/sh
# Claudius replacement for Debian's calamares-bootloader-config.
#
# Puts the GRUB package that matches the firmware (grub-pc for BIOS,
# grub-efi-amd64 for UEFI) into the newly installed system. The .deb files
# ship inside the Claudius image, so this works offline. Calamares' own
# bootloader step then runs grub-install and grub-mkconfig.
set -u

CHROOT=$(findmnt -rn -o TARGET 2>/dev/null | grep -m1 '^/tmp/calamares-root')
if [ -z "$CHROOT" ]; then
    CHROOT=$(mount | grep proc | grep calamares | awk '{print $3}' | sed -e 's#/proc##g' | head -n1)
fi
if [ -z "$CHROOT" ] || [ ! -d "$CHROOT" ]; then
    echo "claudius-bootloader-config: installation target not found"
    exit 1
fi

if [ -d /sys/firmware/efi/efivars ]; then PKG=grub-efi-amd64; else PKG=grub-pc; fi
DEBS=/usr/share/claudius/grub-debs
export DEBIAN_FRONTEND=noninteractive
echo "claudius-bootloader-config: installing $PKG into $CHROOT"

if ls "$CHROOT$DEBS/${PKG}"_*.deb >/dev/null 2>&1; then
    chroot "$CHROOT" sh -c "dpkg -i $DEBS/${PKG}_*.deb" \
        || chroot "$CHROOT" apt-get -y install "$PKG" \
        || echo "claudius-bootloader-config: $PKG could not be installed (GRUB still gets installed by Calamares)"
else
    chroot "$CHROOT" apt-get -y install "$PKG" || true
fi

# The other firmware's package isn't needed on the installed system
rm -rf "${CHROOT:?}$DEBS"
exit 0
