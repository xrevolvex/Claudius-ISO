#!/bin/bash
# claudius: friendly shortcuts for everyday system tasks.
. /etc/claudius-release 2>/dev/null

A=$'\e[38;5;215m'; C=$'\e[38;5;209m'; B=$'\e[1m'; D=$'\e[2m'; R=$'\e[0m'

usage() {
cat <<EOF

  ${A}${B}●${R}
  ${C}${B}Claudius ${CLAUDIUS_VERSION} ${CLAUDIUS_CODENAME}${R}  ${D}shortcuts${R}

  ${B}claudius info${R}             system summary
  ${B}claudius ram${R}              memory use, top apps and the active performance profile
  ${B}claudius profile${R} [name]   show or set the profile: auto, lite, balanced, performance
  ${B}claudius update${R}           update everything
  ${B}claudius install${R} <app>    install apps   (e.g. claudius install gimp)
  ${B}claudius remove${R} <app>     remove apps
  ${B}claudius search${R} <word>    search the app catalogue
  ${B}claudius clean${R}            free disk space (package cache, old logs, trash)

  ${B}claudius python${R} <file>    run a Python script     ${D}(no file: open Python)${R}
  ${B}claudius newpy${R} [folder]   new Python project with its own virtual environment
  ${B}claudius layout${R} [name]    desktop layout: classic (Windows-like) or ubuntu
  ${B}claudius refresh${R} [rate]   screen refresh rate: auto, 60, 75, 120, 144, 165, 240
  ${B}claudius flatpak${R} <app>    install an app from Flathub (e.g. org.gimp.GIMP)
  ${B}claudius firewall${R} [on|off] show or switch the firewall (ufw)
  ${B}claudius guest-additions${R}  install VirtualBox Guest Additions (auto-resize, clipboard)

  ${B}claudius center${R} [page]    open Claudius Center (updates, apps, security, backup, monitor…)
  ${B}claudius capture${R}          screenshots and screen recording
  ${B}claudius setup${R}            the setup checklist

  ${B}claudius tips${R}             keyboard shortcuts and tricks
  ${B}claudius about${R}            version and project link

EOF
}

case "${1:-}" in
    info|fetch)   fastfetch ;;
    ram|mem|memory)
        [ -r /run/claudius/tune ] && . /run/claudius/tune
        echo
        echo "  ${B}Profile:${R} ${A}${PROFILE:-unknown}${R}   ${D}(${MEM_MB:-?} MB RAM, ${CPUS:-?} CPUs, zram ${ZRAM_PERCENT:-?}%, Firefox processes ${FIREFOX_PROCESSES:-?})${R}"
        echo
        free -h
        echo
        echo "  ${B}Top memory users${R}"
        ps -eo rss=,comm= --sort=-rss | head -n 8 | awk '{printf "  %7.0f MB  %s\n", $1/1024, $2}'
        echo ;;
    profile)
        if [ -n "${2:-}" ]; then
            case "$2" in auto|lite|balanced|performance) ;; *) echo "use: auto, lite, balanced or performance"; exit 1 ;; esac
            sudo mkdir -p /etc/claudius && echo "$2" | sudo tee /etc/claudius/profile >/dev/null
            sudo /usr/bin/claudius-tune
            echo "Saved. Some settings (window effects, Firefox) apply after you log out and back in."
        else
            [ -r /run/claudius/tune ] && cat /run/claudius/tune
        fi ;;
    update|upgrade) sudo apt update && sudo apt full-upgrade -y && sudo apt autoremove -y ;;
    install)  shift; [ $# -gt 0 ] || { echo "what should I install?"; exit 1; }; sudo apt install -y "$@" ;;
    remove)   shift; [ $# -gt 0 ] || { echo "what should I remove?"; exit 1; }; sudo apt remove -y "$@" ;;
    search)   shift; apt search "$@" 2>/dev/null ;;
    clean)
        sudo apt clean && sudo apt autoremove -y
        sudo journalctl --vacuum-size=50M >/dev/null 2>&1
        rm -rf "$HOME/.local/share/Trash/"* "$HOME/.cache/thumbnails/"* 2>/dev/null
        df -h / ;;
    python|py|run)
        shift
        if [ $# -eq 0 ]; then exec ipython3 2>/dev/null || exec python3; fi
        exec claudius-run-python "$@" ;;
    newpy|new-python|new-project)
        exec python3 /usr/share/claudius/python/new_project.py "${2:-$PWD}" ;;
    layout)  exec claudius-layout "${2:-}" ;;
    center|settings) if [ -n "${2:-}" ]; then exec claudius-center --page "$2"; else exec claudius-center; fi ;;
    capture|screenshot) exec claudius-capture ;;
    setup)   exec claudius-setup ;;
    refresh|hz)
        if [ -n "${2:-}" ]; then
            case "$2" in auto|60|75|90|100|120|144|165|240) ;; *) echo "use: auto, 60, 75, 120, 144, 165 or 240"; exit 1 ;; esac
            sudo mkdir -p /etc/claudius && echo "$2" | sudo tee /etc/claudius/refresh >/dev/null
            sudo env DISPLAY="$DISPLAY" XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}" /usr/bin/claudius-display-setup
        fi
        [ -r /run/claudius/display ] && . /run/claudius/display
        echo "Screen: ${MODE:-?} at ${REFRESH:-?} Hz on ${OUTPUT:-?}  (setting: $(cat /etc/claudius/refresh 2>/dev/null || echo auto), machine: ${VIRT:-?})" ;;
    flatpak)
        shift; [ $# -gt 0 ] || { echo "which app? find IDs at https://flathub.org  (e.g. org.gimp.GIMP)"; exit 1; }
        flatpak remote-add --if-not-exists --user flathub https://dl.flathub.org/repo/flathub.flatpakrepo
        flatpak install --user -y flathub "$@" ;;
    firewall|ufw)
        case "${2:-}" in
            on)  sudo ufw enable ;;
            off) sudo ufw disable ;;
            *)   sudo ufw status verbose ;;
        esac ;;
    guest-additions|vbox|ga)
        echo "Installing what the VirtualBox Guest Additions need..."
        sudo apt update && sudo apt install -y build-essential dkms "linux-headers-$(uname -r)" || exit 1
        echo
        echo "Now, in the VirtualBox window menu: Devices > Insert Guest Additions CD image..."
        read -r -p "Press Enter when the CD is inserted. " _
        sudo mkdir -p /mnt/vbox-ga
        sudo mount -o ro /dev/sr0 /mnt/vbox-ga 2>/dev/null || sudo mount -o ro /dev/cdrom /mnt/vbox-ga
        if [ -f /mnt/vbox-ga/VBoxLinuxAdditions.run ]; then
            sudo sh /mnt/vbox-ga/VBoxLinuxAdditions.run
            sudo umount /mnt/vbox-ga
            echo "Done. Restart Claudius to turn on auto-resize and the shared clipboard."
        else
            echo "Couldn't find the Guest Additions CD. Insert it and run this again."
        fi ;;
    tips)
cat <<EOF

  ${B}Keyboard${R}
    Super ............... Launcher (search)   Super+A ......... all apps
    Super+S ............. Quick Settings      Super+N ......... notifications
    Super+I ............. Claudius Center     Ctrl+Alt+T ...... terminal
    Super+E ............. files               Super+B ......... browser
    Print ............... screenshot (annotate)   Shift+Print .. whole screen
    Super+Shift+R ....... start/stop recording    Ctrl+Shift+Esc System Monitor
    Super+Arrows ........ tile windows        Alt+Tab ......... switch windows

  ${B}VirtualBox${R}
    Bigger screen: Settings > Display, or Devices > Insert Guest Additions CD
    Shared clipboard and folders need the Guest Additions (see the README)

  ${B}Terminal${R}
    Tab completes commands and file names. Ctrl+R searches your history.
    Mistyped or missing command? Claudius suggests the package to install.

  ${B}Python${R}
    Double-click a .py file to open it in Thonny (F5 runs it).
    Right-click > Run with Python runs it in a terminal. Examples: ~/Python

  ${B}Looks${R}
    claudius layout ubuntu   top bar + dock, Yaru theme
    claudius layout classic  bottom taskbar + start menu

EOF
        ;;
    about|version|--version|-v)
        echo "Claudius ${CLAUDIUS_VERSION} (${CLAUDIUS_CODENAME}), built ${CLAUDIUS_BUILD_DATE}, based on Debian $(cat /etc/debian_version 2>/dev/null)"
        echo "${CLAUDIUS_URL}" ;;
    ""|help|-h|--help) usage ;;
    *) echo "unknown command: $1"; usage; exit 1 ;;
esac
