#!/usr/bin/env python3
"""
claudius-splash: the login-to-desktop animation.

Started from /etc/X11/Xsession.d before XFCE. It continues where the login
screen stopped (the C breathing in the centre), waits until the desktop and
taskbar are running, then glides the C into the exact place it has on the
wallpaper and disappears, so the desktop seems to grow out of it.

Turn it off:  touch ~/.config/claudius/no-splash
"""
import json
import math
import os
import subprocess
import sys
import time

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

BG = (0x12 / 255, 0x18 / 255, 0x30 / 255)
ORANGE = (1.0, 0x94 / 255, 0x47 / 255)
GEOMETRY = "/usr/share/claudius/geometry.json"
TAG = "/usr/share/claudius/logo/version-tag.png"
MAX_WAIT = 14.0      # never cover the desktop longer than this
GLIDE = 0.7


def ease_in_out(t):
    t = max(0.0, min(1.0, t))
    return 4 * t * t * t if t < 0.5 else 1 - (-2 * t + 2) ** 3 / 2


def draw_c(cr, cx, cy, box, alpha=1.0):
    k = box / 512.0
    cr.set_source_rgba(*ORANGE, alpha)
    cr.set_line_width(52.8 * k)
    cr.set_line_cap(1)  # round
    cr.new_path()
    cr.arc_negative(cx, cy + 24.64 * k, 123.2 * k, math.radians(312), math.radians(48))
    cr.stroke()
    cr.arc(cx, cy + (85.1 - 256) * k, 22.18 * k, 0, 2 * math.pi)
    cr.fill()


def running(name):
    return subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", name],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


class Splash(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        screen = Gdk.Screen.get_default()
        self.W, self.H = screen.get_width(), screen.get_height()
        self.set_default_size(self.W, self.H)
        self.move(0, 0)
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.SPLASHSCREEN)
        self.set_app_paintable(True)
        self.fullscreen()

        g = {"anim": {"box": 220}, "wallpaper": {"width": 1920, "height": 1080, "cx": 960, "cy": 615.6, "box": 256}}
        try:
            with open(GEOMETRY) as fh:
                g = json.load(fh)
        except (OSError, ValueError):
            pass
        self.start_box = g["anim"]["box"]
        w = g["wallpaper"]
        # The wallpaper is shown "zoomed" (scaled to cover, centred): map its C onto this screen
        scale = max(self.W / w["width"], self.H / w["height"])
        ox = (self.W - w["width"] * scale) / 2
        oy = (self.H - w["height"] * scale) / 2
        self.end = (ox + w["cx"] * scale, oy + w["cy"] * scale, w["box"] * scale)

        self.tag = None
        try:
            import cairo
            self.tag = cairo.ImageSurface.create_from_png(TAG)
        except Exception:  # noqa: BLE001
            pass

        area = Gtk.DrawingArea()
        area.connect("draw", self.on_draw)
        self.add(area)
        self.t0 = time.monotonic()
        self.ready_t = None
        self.glide_t = None
        area.add_tick_callback(self.on_tick)
        GLib.timeout_add(250, self.check_ready)

    def check_ready(self):
        t = time.monotonic() - self.t0
        if self.ready_t is None and ((running("xfdesktop") and running("xfce4-panel")) or t > MAX_WAIT):
            self.ready_t = time.monotonic()
        if self.ready_t is not None and self.glide_t is None and time.monotonic() - self.ready_t > 1.2:
            self.glide_t = time.monotonic()
            return False
        return True

    def on_tick(self, widget, _clock):
        if self.glide_t is not None and time.monotonic() - self.glide_t > GLIDE + 0.15:
            Gtk.main_quit()
            return False
        widget.queue_draw()
        return True

    def on_draw(self, _widget, cr):
        cr.set_source_rgb(*BG)
        cr.paint()
        now = time.monotonic()
        sx, sy, sb = self.W / 2, self.H / 2, self.start_box
        if self.glide_t is None:
            t = now - self.t0
            alpha = 0.62 + 0.38 * (0.5 + 0.5 * math.cos(2 * math.pi * t / 1.3))
            draw_c(cr, sx, sy, sb, alpha)
            cr.set_source_rgba(0.78, 0.8, 0.88, 1)
            cr.select_font_face("Cantarell")
            cr.set_font_size(15)
            msg = "Starting your desktop…"
            ext = cr.text_extents(msg)
            cr.move_to(self.W / 2 - ext.width / 2, self.H / 2 + sb * 0.62)
            cr.show_text(msg)
        else:
            k = ease_in_out((now - self.glide_t) / GLIDE)
            ex, ey, eb = self.end
            draw_c(cr, sx + (ex - sx) * k, sy + (ey - sy) * k, sb + (eb - sb) * k, 1.0)
        if self.tag is not None:
            cr.set_source_surface(self.tag, self.W - self.tag.get_width() - 44, self.H - self.tag.get_height() - 40)
            cr.paint()
        return False


def main():
    if os.path.exists(os.path.expanduser("~/.config/claudius/no-splash")):
        return
    win = Splash()
    win.show_all()
    GLib.timeout_add_seconds(int(MAX_WAIT + 6), Gtk.main_quit)  # hard safety stop
    Gtk.main()


if __name__ == "__main__":
    try:
        main()
    except Exception as err:  # noqa: BLE001  never block the desktop
        print(f"claudius-splash: {err}", file=sys.stderr)
