#!/bin/sh
# Called by LightDM when the X server starts. VirtualBox without Guest
# Additions often starts at 800x600; pick something comfortable instead.
command -v xrandr >/dev/null 2>&1 || exit 0
Q=$(xrandr --query 2>/dev/null) || exit 0
OUT=$(printf '%s\n' "$Q" | awk '/ connected/ {print $1; exit}')
[ -n "$OUT" ] || exit 0
CUR=$(printf '%s\n' "$Q" | awk '/\*/ {print $1; exit}')
W=${CUR%%x*}
case "$W" in ''|*[!0-9]*) W=0 ;; esac
[ "$W" -ge 1280 ] && exit 0
for m in 1920x1080 1680x1050 1600x900 1440x900 1366x768 1280x800 1280x720 1024x768; do
    if printf '%s\n' "$Q" | grep -q "^ *$m "; then
        xrandr --output "$OUT" --mode "$m" && exit 0
    fi
done
exit 0
