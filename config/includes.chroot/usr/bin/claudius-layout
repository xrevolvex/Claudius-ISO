#!/bin/bash
# =============================================================================
#  claudius-layout: switch the desktop between layouts.
#
#    claudius-layout classic   bottom taskbar + start menu (Windows-like), Arc-Dark
#    claudius-layout ubuntu    top bar + left dock (Ubuntu-like), Yaru-dark
#    claudius-layout           pick one in a dialog
# =============================================================================
set -u
CHOICE="${1:-}"
if [ -z "$CHOICE" ]; then
    CHOICE=$(zenity --list --radiolist --title "Desktop layout" --width 440 --height 260 \
        --text "Choose how your Claudius desktop looks:" \
        --column "" --column "Layout" --column "Description" \
        TRUE classic "Taskbar at the bottom, start menu (Windows-like)" \
        FALSE ubuntu "Top bar and a dock on the left (Ubuntu-like)" 2>/dev/null) || exit 0
fi

CONF="$HOME/.config/xfce4/xfconf/xfce-perchannel-xml"
PANEL_DIR="$HOME/.config/xfce4/panel"
mkdir -p "$CONF" "$PANEL_DIR"
xq() { xfconf-query "$@" 2>/dev/null || true; }

theme() {  # theme <gtk> <icons> <wm> <font>
    xq -c xsettings -p /Net/ThemeName -s "$1"
    xq -c xsettings -p /Net/IconThemeName -s "$2"
    [ -d "/usr/share/themes/$3/xfwm4" ] && xq -c xfwm4 -p /general/theme -s "$3"
    xq -c xsettings -p /Gtk/FontName -s "$4"
}

restart_panel() {  # restart_panel <xml file>
    xfce4-panel --quit 2>/dev/null
    pkill -x xfconfd 2>/dev/null
    sleep 1
    rm -rf "$PANEL_DIR"/launcher-* "$PANEL_DIR"/docklike-*
    cp "$1" "$CONF/xfce4-panel.xml"
    for rc in "$(dirname "$1")"/docklike-*.rc; do [ -f "$rc" ] && cp "$rc" "$PANEL_DIR/"; done
    (setsid xfce4-panel >/dev/null 2>&1 &)
    sleep 2
}

case "$CHOICE" in
    classic|windows|default)
        restart_panel /etc/xdg/xfce4/panel/default.xml
        theme Arc-Dark Papirus-Dark Arc-Dark "Cantarell 10"
        echo classic > "$HOME/.config/claudius/layout" 2>/dev/null ;;
    ubuntu)
        L=/usr/share/claudius/layouts/ubuntu
        if ls /usr/lib/*/xfce4/panel/plugins/libdocklike.so >/dev/null 2>&1; then
            restart_panel "$L/xfce4-panel.xml"
        else   # no dock plugin: use an icon-only task list instead
            T=$(mktemp -d); sed 's/value="docklike"\/>/value="tasklist"><property name="show-labels" type="bool" value="false"\/><\/property>/' \
                "$L/xfce4-panel.xml" > "$T/xfce4-panel.xml"
            restart_panel "$T/xfce4-panel.xml"; rm -rf "$T"
        fi
        if fc-list | grep -qi "Ubuntu"; then FONT="Ubuntu 10"; else FONT="Cantarell 10"; fi
        if [ -d /usr/share/themes/Yaru-dark ]; then
            theme Yaru-dark Yaru-dark Yaru-dark "$FONT"
        else
            theme Arc-Dark Papirus-Dark Arc-Dark "$FONT"
        fi
        mkdir -p "$HOME/.config/claudius"; echo ubuntu > "$HOME/.config/claudius/layout" ;;
    *) echo "usage: claudius-layout [classic|ubuntu]"; exit 1 ;;
esac
echo "Layout: $CHOICE"
