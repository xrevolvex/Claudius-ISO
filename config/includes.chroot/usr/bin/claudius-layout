#!/bin/bash
# =============================================================================
#  claudius-layout: switch the desktop layout. Nothing is reinstalled.
#
#    claudius-layout classic   Windows-like: bottom taskbar with a start menu
#    claudius-layout macos     macOS-like: top menu bar + zooming dock (Plank)
#    claudius-layout ubuntu    Ubuntu-like: top bar + dock on the left, Yaru theme
#    claudius-layout           choose in a dialog
# =============================================================================
set -u
CHOICE="${1:-}"
if [ -z "$CHOICE" ]; then
    CHOICE=$(zenity --list --radiolist --title "Desktop layout" --width 480 --height 300 \
        --text "Choose how your Claudius desktop looks:" \
        --column "" --column "Layout" --column "Description" \
        TRUE classic "Windows: taskbar at the bottom, start menu" \
        FALSE macos "macOS: top menu bar, zooming dock at the bottom" \
        FALSE ubuntu "Ubuntu: top bar, dock on the left" 2>/dev/null) || exit 0
fi

CONF="$HOME/.config/xfce4/xfconf/xfce-perchannel-xml"
PANEL_DIR="$HOME/.config/xfce4/panel"
L=/usr/share/claudius/layouts
mkdir -p "$CONF" "$PANEL_DIR" "$HOME/.config/claudius" "$HOME/.config/autostart"
xq() { xfconf-query "$@" 2>/dev/null || true; }

theme() {  # theme <gtk> <icons> <wm>
    xq -c xsettings -p /Net/ThemeName -s "$1"
    xq -c xsettings -p /Net/IconThemeName -s "$2"
    [ -d "/usr/share/themes/$3/xfwm4" ] && xq -c xfwm4 -p /general/theme -s "$3"
}

restart_panel() {  # restart_panel <xml file>
    xfce4-panel --quit 2>/dev/null
    pkill -x xfconfd 2>/dev/null
    sleep 1
    rm -rf "$PANEL_DIR"/launcher-* "$PANEL_DIR"/docklike-*
    cp "$1" "$CONF/xfce4-panel.xml"
    for rc in "$(dirname "$1")"/docklike-*.rc; do [ -f "$rc" ] && cp "$rc" "$PANEL_DIR/"; done
    (setsid xfce4-panel >/dev/null 2>&1 &)
    sleep 2
}

dock_off() {
    pkill -x plank 2>/dev/null
    rm -f "$HOME/.config/autostart/plank.desktop"
}

dock_on() {
    command -v plank >/dev/null || return 0
    local S="net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/"
    local D="$HOME/.config/plank/dock1/launchers"
    if [ ! -d "$D" ] || [ -z "$(ls -A "$D" 2>/dev/null)" ]; then
        mkdir -p "$D"
        for app in brave-browser thunar xfce4-terminal libreoffice-writer vlc org.thonny.Thonny claudius-center; do
            [ -f "/usr/share/applications/$app.desktop" ] && printf '[PlankDockItemPreferences]\nLauncher=file:///usr/share/applications/%s.desktop\n' "$app" > "$D/$app.dockitem"
        done
    fi
    gsettings set "$S" theme 'Claudius' 2>/dev/null
    gsettings set "$S" zoom-enabled true 2>/dev/null
    gsettings set "$S" zoom-percent 165 2>/dev/null
    gsettings set "$S" icon-size 48 2>/dev/null
    gsettings set "$S" position 'bottom' 2>/dev/null
    gsettings set "$S" hide-mode 'dodge-maximized' 2>/dev/null
    gsettings set "$S" show-dock-item false 2>/dev/null
    printf '[Desktop Entry]\nType=Application\nName=Plank dock\nExec=plank\nNoDisplay=true\nOnlyShowIn=XFCE;\n' > "$HOME/.config/autostart/plank.desktop"
    pkill -x plank 2>/dev/null
    (setsid plank >/dev/null 2>&1 &)
}

with_dock_fallback() {  # use an icon-only task list if the docklike plugin is missing
    if ls /usr/lib/*/xfce4/panel/plugins/libdocklike.so >/dev/null 2>&1; then
        echo "$1"
    else
        T=$(mktemp -d)
        sed 's/value="docklike"\/>/value="tasklist"><property name="show-labels" type="bool" value="false"\/><\/property>/' "$1" > "$T/xfce4-panel.xml"
        echo "$T/xfce4-panel.xml"
    fi
}

case "$CHOICE" in
    classic|windows|default)
        dock_off
        restart_panel /etc/xdg/xfce4/panel/default.xml
        theme Arc-Dark Papirus-Dark Arc-Dark ;;
    macos|mac)
        restart_panel "$L/macos/xfce4-panel.xml"
        dock_on
        theme Arc-Dark Papirus-Dark Arc-Dark
        xq -c xfwm4 -p /general/button_layout -s "CHM|O" ;;
    ubuntu)
        dock_off
        restart_panel "$(with_dock_fallback "$L/ubuntu/xfce4-panel.xml")"
        if [ -d /usr/share/themes/Yaru-dark ]; then theme Yaru-dark Yaru-dark Yaru-dark; else theme Arc-Dark Papirus-Dark Arc-Dark; fi ;;
    *) echo "usage: claudius-layout [classic|macos|ubuntu]"; exit 1 ;;
esac
[ "$CHOICE" != macos ] && [ "$CHOICE" != mac ] && xq -c xfwm4 -p /general/button_layout -s "O|HMC"
echo "$CHOICE" > "$HOME/.config/claudius/layout"
echo "Layout: $CHOICE"
