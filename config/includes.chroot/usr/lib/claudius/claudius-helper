#!/bin/bash
# =============================================================================
#  claudius-helper: the only part of the Claudius apps that runs as root.
#  Called through pkexec (polkit action org.claudius.helper). Every action and
#  argument is checked here; anything unknown is refused.
# =============================================================================
set -u
export DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8

die() { echo "claudius-helper: $*" >&2; exit 2; }
pkgs_ok() { for p in "$@"; do [[ "$p" =~ ^[a-z0-9][a-z0-9+.:-]*$ ]] || die "bad package name: $p"; done; }
flat_ok() { for p in "$@"; do [[ "$p" =~ ^[A-Za-z0-9._-]+$ ]] || die "bad flatpak id: $p"; done; }
[ "$(id -u)" -eq 0 ] || die "must run as root (through pkexec)"

ACTION="${1:-}"; shift || true
case "$ACTION" in
    apt-update)        apt-get update ;;
    apt-upgrade)       apt-get update && apt-get -y -o Dpkg::Options::=--force-confold full-upgrade && apt-get -y autoremove ;;
    apt-install)       pkgs_ok "$@"; apt-get update -qq; apt-get -y install "$@" ;;
    apt-remove)        pkgs_ok "$@"; apt-get -y remove "$@" && apt-get -y autoremove ;;
    flatpak-install)   flat_ok "$@"
                       flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
                       flatpak install -y --noninteractive flathub "$@" ;;
    flatpak-remove)    flat_ok "$@"; flatpak uninstall -y --noninteractive "$@" ;;
    flatpak-update)    flatpak update -y --noninteractive ;;
    profile)           [[ "${1:-}" =~ ^(auto|lite|balanced|performance)$ ]] || die "bad profile"
                       mkdir -p /etc/claudius && echo "$1" > /etc/claudius/profile && /usr/bin/claudius-tune ;;
    refresh)           [[ "${1:-}" =~ ^(auto|60|75|90|100|120|144|165|240)$ ]] || die "bad refresh rate"
                       mkdir -p /etc/claudius && echo "$1" > /etc/claudius/refresh ;;
    firewall)          case "${1:-}" in on) ufw --force enable ;; off) ufw disable ;; *) die "on|off" ;; esac ;;
    auto-updates)      case "${1:-}" in
                           on)  printf 'APT::Periodic::Update-Package-Lists "1";\nAPT::Periodic::Unattended-Upgrade "1";\n' > /etc/apt/apt.conf.d/20auto-upgrades ;;
                           off) printf 'APT::Periodic::Update-Package-Lists "0";\nAPT::Periodic::Unattended-Upgrade "0";\n' > /etc/apt/apt.conf.d/20auto-upgrades ;;
                           *)   die "on|off" ;;
                       esac ;;
    snapshot-create)   command -v timeshift >/dev/null || die "timeshift is not installed"
                       [[ "${1:-}" =~ ^[A-Za-z0-9\ ._-]{0,60}$ ]] || die "bad comment"
                       timeshift --create --comments "${1:-Claudius snapshot}" --scripted \
                           --snapshot-device "$(findmnt -no SOURCE / | sed 's/\[.*//')" ;;
    snapshot-list)     command -v timeshift >/dev/null || die "timeshift is not installed"
                       timeshift --list --scripted ;;
    xrdp)              case "${1:-}" in
                           on)  apt-get -y install xrdp && systemctl enable --now xrdp && { ufw allow 3389/tcp || true; } ;;
                           off) systemctl disable --now xrdp 2>/dev/null; ufw delete allow 3389/tcp 2>/dev/null || true ;;
                           *)   die "on|off" ;;
                       esac ;;
    vbox-additions)    # build the VirtualBox Guest Additions from the CD the user inserted
                       apt-get update -qq && apt-get -y install build-essential dkms "linux-headers-$(uname -r)" || exit 1
                       mkdir -p /mnt/vbox-ga
                       mount -o ro /dev/sr0 /mnt/vbox-ga 2>/dev/null || mount -o ro /dev/cdrom /mnt/vbox-ga 2>/dev/null \
                           || die "insert the Guest Additions CD first (VirtualBox menu: Devices)"
                       [ -f /mnt/vbox-ga/VBoxLinuxAdditions.run ] || { umount /mnt/vbox-ga; die "that CD is not the Guest Additions CD"; }
                       sh /mnt/vbox-ga/VBoxLinuxAdditions.run --nox11; rc=$?; umount /mnt/vbox-ga; exit $rc ;;
    apt-upgrade-safe)  # snapshot first (if Timeshift is set up and the user wants it), then update
                       if [ -f /etc/claudius/snapshot-before-updates ] && command -v timeshift >/dev/null; then
                           echo ">> Creating a system snapshot before updating..."
                           timeshift --create --comments "Before update $(date +%F)" --tags O --scripted \
                               --snapshot-device "$(findmnt -no SOURCE / | sed 's/\[.*//')" || echo ">> (snapshot failed, continuing)"
                       fi
                       apt-get update && apt-get -y -o Dpkg::Options::=--force-confold full-upgrade && apt-get -y autoremove
                       if command -v flatpak >/dev/null; then flatpak update -y --noninteractive; fi ;;
    repair)            # recover from an interrupted or failed update
                       dpkg --configure -a; apt-get -y -f install; apt-get update; apt-get -y -o Dpkg::Options::=--force-confold full-upgrade ;;
    snapshot-before-updates) mkdir -p /etc/claudius
                       case "${1:-}" in on) touch /etc/claudius/snapshot-before-updates ;; off) rm -f /etc/claudius/snapshot-before-updates ;; *) die "on|off" ;; esac ;;
    schedule-restart)  [[ "${1:-}" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$|^now$ ]] || die "time must be HH:MM"
                       shutdown -r "$1" "Claudius: restarting to finish updates" ;;
    cancel-restart)    shutdown -c ;;
    auto-reboot)       # unattended-upgrades: restart automatically at a set time when an update needs it
                       F=/etc/apt/apt.conf.d/52claudius-auto-reboot
                       case "${1:-}" in
                           off) rm -f "$F" ;;
                           *)   [[ "${1:-}" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || die "time must be HH:MM"
                                printf 'Unattended-Upgrade::Automatic-Reboot "true";\nUnattended-Upgrade::Automatic-Reboot-Time "%s";\n' "$1" > "$F" ;;
                       esac ;;
    ufw-status)        ufw status numbered; echo "---verbose"; ufw status verbose | sed -n '1,8p' ;;
    ufw-rule)          # ufw-rule allow|deny|limit <port>[/tcp|/udp]   or   ufw-rule delete <number>
                       case "${1:-}" in
                           allow|deny|limit) [[ "${2:-}" =~ ^[0-9]{1,5}(:[0-9]{1,5})?(/(tcp|udp))?$ ]] || die "bad port"; ufw "$1" "$2" ;;
                           delete)           [[ "${2:-}" =~ ^[0-9]{1,3}$ ]] || die "bad rule number"; ufw --force delete "$2" ;;
                           *)                die "allow|deny|limit|delete" ;;
                       esac ;;
    ufw-default)       [[ "${1:-}" =~ ^(allow|deny|reject)$ ]] || die "allow|deny|reject"; ufw default "$1" incoming ;;
    set-locale)        [[ "${1:-}" =~ ^[a-z]{2,3}_[A-Z]{2}\.UTF-8$ ]] || die "bad locale"
                       sed -i "s/^# *\(${1//./\\.} UTF-8\)/\1/" /etc/locale.gen; locale-gen; update-locale LANG="$1" ;;
    set-keymap)        [[ "${1:-}" =~ ^[a-z]{2,3}$ ]] || die "bad layout"
                       localectl set-x11-keymap "$1" 2>/dev/null || sed -i "s/^XKBLAYOUT=.*/XKBLAYOUT=\"$1\"/" /etc/default/keyboard ;;
    rfkill)            [[ "${1:-}" =~ ^(bluetooth|wlan|all)$ ]] || die "bluetooth|wlan|all"
                       case "${2:-}" in on) rfkill unblock "$1" ;; off) rfkill block "$1" ;; *) die "on|off" ;; esac ;;
    *)                 die "unknown action '$ACTION'" ;;
esac
