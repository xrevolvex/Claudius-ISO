<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>utilities-terminal</icon>
	<name>Open Terminal Here</name>
	<submenu></submenu>
	<unique-id>claudius-open-terminal</unique-id>
	<command>exo-open --working-directory %f --launch TerminalEmulator</command>
	<description>Open a terminal in this folder</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
<action>
	<icon>text-x-python</icon>
	<name>Run with Python</name>
	<submenu></submenu>
	<unique-id>claudius-run-python</unique-id>
	<command>claudius-run-python %f</command>
	<description>Run this script in a terminal</description>
	<range>*</range>
	<patterns>*.py;*.pyw</patterns>
	<text-files/>
	<other-files/>
</action>
<action>
	<icon>thonny</icon>
	<name>Edit in Thonny</name>
	<submenu></submenu>
	<unique-id>claudius-edit-thonny</unique-id>
	<command>thonny %F</command>
	<description>Open in the Thonny Python editor</description>
	<range>*</range>
	<patterns>*.py;*.pyw</patterns>
	<text-files/>
	<other-files/>
</action>
<action>
	<icon>folder-new</icon>
	<name>New Python project here</name>
	<submenu></submenu>
	<unique-id>claudius-new-python-project</unique-id>
	<command>claudius-run-python /usr/share/claudius/python/new_project.py %f</command>
	<description>Create a folder with a virtual environment and a starter script</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
</action>
<action>
	<icon>preferences-desktop-wallpaper</icon>
	<name>Set as wallpaper</name>
	<submenu></submenu>
	<unique-id>claudius-set-wallpaper</unique-id>
	<command>claudius-set-wallpaper %f</command>
	<description>Use this picture as the desktop background</description>
	<range>1-1</range>
	<patterns>*.png;*.jpg;*.jpeg;*.webp;*.svg;*.PNG;*.JPG;*.JPEG</patterns>
	<image-files/>
</action>
<action>
	<icon>edit-copy</icon>
	<name>Copy path</name>
	<submenu></submenu>
	<unique-id>claudius-copy-path</unique-id>
	<command>sh -c 'printf "%%s" "$1" | xclip -selection clipboard' _ %f</command>
	<description>Copy the full path of this item</description>
	<range>1-1</range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
<action>
	<icon>dialog-password</icon>
	<name>Open as administrator</name>
	<submenu></submenu>
	<unique-id>claudius-open-root</unique-id>
	<command>pkexec env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" thunar %f</command>
	<description>Open this folder with administrator rights (be careful)</description>
	<range>1-1</range>
	<patterns>*</patterns>
	<directories/>
</action>
<action>
	<icon>utilities-terminal</icon>
	<name>Run in terminal</name>
	<submenu></submenu>
	<unique-id>claudius-run-script</unique-id>
	<command>xfce4-terminal --hold --working-directory %d -x %f</command>
	<description>Run this script or program in a terminal</description>
	<range>1-1</range>
	<patterns>*.sh;*.run;*.AppImage;*.appimage</patterns>
	<other-files/>
	<text-files/>
</action>
</actions>
